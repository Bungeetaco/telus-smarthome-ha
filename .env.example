# Copy to .env next to docker-compose.yml and set your Docker host's LAN IP.
# This is the address Home Assistant will use to READ the RTSP stream, so it
# must be reachable from your HA instance (not 127.0.0.1).
LAN_IP=192.168.1.10

# Camera audio in the stream. 1 = on (default), 0 = video-only.
ENABLE_AUDIO=1

# Mic boost in dB (camera mic is quiet). 0 = none. Typical 15-25.
AUDIO_GAIN_DB=15

# Shared secret between the integration and the bridge's control API
# (/session/start and /stop; /health stays open). Generate one with
# `openssl rand -hex 24`, put the same value in the integration's
# "bridge token" option. Empty = no authentication (loopback deployments).
BRIDGE_TOKEN=

# Camera audio is mixed with a silence source so the stream always has one
# audio track; this is how late (ms) camera audio may arrive before the slot
# is filled with silence. Also the extra audio latency. Default 1000.
AUDIO_MIX_LATENCY_MS=1000
